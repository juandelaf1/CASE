# CASE Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Provider selection: mock | groq | ollama | cloud
CASE_PROVIDER=mock

# API authentication (optional; when set, clients must send X-API-Key header)
CASE_API_KEY=

# Backend URL for Streamlit client
CASE_API_BASE_URL=http://localhost:8000

# SQLite database path (optional, default: case_audit.db)
CASE_DB_PATH=

# Circuit breaker configuration
CASE_CB_FAILURE_THRESHOLD=5
CASE_CB_RECOVERY_TIMEOUT=30

# Groq provider
CASE_GROQ_API_KEY=
CASE_GROQ_MODEL=
CASE_GROQ_BASE_URL=

# Ollama provider
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Cloud/OpenAI-compatible provider
CASE_CLOUD_API_KEY=
CASE_CLOUD_BASE_URL=
CASE_CLOUD_MODEL=
