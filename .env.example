# CASE Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Runtime / provider ---
# Provider selection: mock | groq | ollama | cloud
CASE_PROVIDER=mock

# --- Security (recommended for non-local deployments) ---
# Modes: dev | shared | prod
# - dev: open access allowed only when NO credentials are configured (local/dev convenience)
# - shared/prod: fail-closed startup; require credentials and enforce server-derived identity/scopes
#   Supported strict target: SINGLE authorized consumer/tenant, single instance, single process, SQLite.
#   Shared multi-consumer / multi-worker is NOT demonstrated or enabled (fail-closed).
CASE_SECURITY_MODE=dev

# Single-credential config (strict modes): grants scopes/identity server-side
CASE_API_KEY=
CASE_CONSUMER_ID=default-consumer
CASE_TENANT_ID=
CASE_ORGANIZATION_ID=
CASE_API_SCOPES=case:evaluate

# Multi-credential config (JSON) - strict shared/prod fail-closed for multiple consumers/tenants
# CASE_API_KEYS={"<api-key>":{"consumer_id":"c1","tenant_id":"t1","scopes":["case:evaluate","case:read"],"active":true}}

# --- Backend / persistence ---
CASE_API_BASE_URL=http://localhost:8000
# SQLite database path (optional, default: case_audit.db)
CASE_DB_PATH=

# --- Circuit breaker ---
CASE_CB_FAILURE_THRESHOLD=5
CASE_CB_RECOVERY_TIMEOUT=30

# --- Providers (configure only what you use) ---
# Groq
CASE_GROQ_API_KEY=
CASE_GROQ_MODEL=
CASE_GROQ_BASE_URL=

# Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Cloud/OpenAI-compatible
CASE_CLOUD_API_KEY=
CASE_CLOUD_BASE_URL=
CASE_CLOUD_MODEL=
