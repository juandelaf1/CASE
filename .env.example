# CASE Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Provider selection: mock | groq | ollama | cloud
CASE_PROVIDER=mock

# Groq API key (required when CASE_PROVIDER=groq)
CASE_GROQ_API_KEY=

# Groq model (optional, default: qwen/qwen3.8-27b)
CASE_GROQ_MODEL=

# Ollama model (optional, default: llama3.2)
CASE_OLLAMA_MODEL=

# Cloud/OpenAI-compatible API key (required when CASE_PROVIDER=cloud)
CASE_CLOUD_API_KEY=

# Cloud base URL (optional, default: https://api.openai.com/v1)
CASE_CLOUD_BASE_URL=

# Cloud model (optional, default: gpt-4o-mini)
CASE_CLOUD_MODEL=

# SQLite database path (optional, default: case_audit.db)
CASE_DB_PATH=
