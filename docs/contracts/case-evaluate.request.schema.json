{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://case.local/contracts/case-evaluate.request.schema.json",
  "title": "CASE Evaluate Request",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "capability_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "case-eval/v0.1-draft"
    },
    "capability_id": {
      "type": "string",
      "const": "case.evaluate"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "caller": {
      "type": "object",
      "additionalProperties": true
    },
    "tenant_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "organization_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "domain"
      ],
      "properties": {
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "urgency": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "type",
              "content"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "extracted_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "summary"
          ]
        },
        {
          "required": [
            "report_text"
          ]
        }
      ]
    }
  }
}