# Ejemplo de entorno por consumidor (instancia aislada CASE)
# Copiar a .env.<consumer> y completar secretos fuera de control de versiones.
# NO commitear valores reales.

# --- Identidad de despliegue ---
COMPOSE_PROJECT_NAME=case-poolar
CASE_INSTANCE_NAME=case-poolar

# --- Puertos host (evitar colisiones entre instancias) ---
CASE_API_PORT=8001
CASE_UI_PORT=8502

# --- Seguridad (strict single-consumer) ---
CASE_SECURITY_MODE=shared
CASE_API_KEY=__REPLACE_WITH_SECRET__
CASE_CONSUMER_ID=poolar
CASE_TENANT_ID=poolar-tenant
CASE_ORGANIZATION_ID=
# Scopes mínimos necesarios; ajustar al contrato del consumidor
CASE_API_SCOPES=case:evaluate,case:read,case:triage,case:audit:read

# --- Persistencia independiente ---
# Ruta dentro del contenedor; mapear a volumen dedicado por instancia
CASE_DB_PATH=/app/data/case_poolar.db

# --- Provider/runtime (ajustar; mock por defecto para validación local) ---
CASE_PROVIDER=mock
CASE_API_BASE_URL=http://localhost:8001
# CASE_GROQ_API_KEY=
# CASE_GROQ_MODEL=

# --- Operación (documentar por instancia) ---
# BACKUP_SCHEDULE=manual|cron
# POLICY_PROFILE=poolar-default
# AUDIT_RETENTION_DAYS=90
# UPDATE_CHANNEL=pinned
